    "lib/",
    "public/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoatHacks/signalk-webapp-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/BoatHacks/signalk-webapp-launcher/issues"
