{
  "name": "signalk-launcher",
  "version": "0.1.0",
  "description": "SignalK webapp launcher with reorderable, renameable app icons and optional description text",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
